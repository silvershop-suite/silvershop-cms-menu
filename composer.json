{
    "name": "silvershop-suite/cms-menu",
    "description": "Grouped, collapsible CMS left menu for the SilverShop suite: nests the stock Silverstripe 6 admin menu into config-driven groups with Lucide icons, a dependency-free chevron toggle, active-group auto-expand, and count badges (e.g. orders needing attention). Shop-agnostic; blends with the stock admin and its dark mode. Adopted from xddesigners/silverstripe-better-menu.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "cms", "admin", "menu", "grouped menu", "icons", "badges", "ux"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-cms-menu/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/admin": "^3.0"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "suggest": {
        "silvershop-suite/cms-ui": "Provides the Lucide .ss-icon-* webfont the menu icons use (today; will split into silvershop-suite/cms-icons). Without it the menu still works — icons just show as tofu."
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\CmsMenu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\CmsMenu\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
